workflow ticket-to-pr {
  meta {
    title       = "Ticket to Pull Request"
    description = "Full development cycle — plan from ticket, implement, push PR, run review swarm, iterate until clean"
    trigger     = "manual"
    targets     = ["worktree"]
    group       = "Development"
  }

  inputs {
    ticket_id  required
    qualify    boolean
    auto_merge boolean
  }

  if qualify {
    call workflow qualify-ticket {
      inputs {
        ticket_id = "{{ticket_id}}"
      }
    }
  }

  call plan { output = "task-plan" }

  call implement {
    retries = 2
    as      = "developer"
  }

  script fmt-fix-pre-verify {
    run = ".conductor/scripts/fmt-fix.sh"
    env = {
      FMT_FIX_ALLOW_FAILURE = "1"
    }
  }

  // Mechanical breakage (another module's test literals, a crate verify
  // doesn't test, pending insta snapshots) goes to fix-precheck with the
  // compiler output or snapshot diffs before verify runs (#3238).
  script precheck-tests {
    run = ".conductor/scripts/precheck-tests.sh"
    env = { FEATURE_BASE_BRANCH = "{{feature_base_branch}}" }
  }

  // A dedicated agent with its own step name: a third implement call would
  // make resume's occurrence matching and prior_contexts lookups ambiguous.
  if precheck-tests.has_precheck_failures {
    call fix-precheck {
      retries = 1
      as      = "developer"
    }
    script fmt-fix-post-precheck {
      run = ".conductor/scripts/fmt-fix.sh"
      env = {
        FMT_FIX_ALLOW_FAILURE = "1"
      }
    }
  }

  script verify {
    run = ".conductor/scripts/verify.sh"
    env = { FEATURE_BASE_BRANCH = "{{feature_base_branch}}" }
  }

  if verify.has_failures {
    call implement {
      retries = 1
      as      = "developer"
    }
    script fmt-fix-pre-reverify {
      run = ".conductor/scripts/fmt-fix.sh"
      env = {
        FMT_FIX_ALLOW_FAILURE = "1"
      }
    }
    script verify {
      run = ".conductor/scripts/verify.sh"
      env = { FEATURE_BASE_BRANCH = "{{feature_base_branch}}" }
    }

    // Still failing after the retry: stop before lint-fix and push-and-pr
    // can open a PR with failing checks (#3216).
    if verify.has_failures {
      script fail-verify {
        run = ".conductor/scripts/fail-verify.sh"
        env = { VERIFY_CONTEXT = "{{prior_context}}" }
      }
    }
  }

  call workflow lint-fix

  script fmt-fix {
    run = ".conductor/scripts/fmt-fix.sh"
  }

  script push-and-pr {
    run = ".conductor/scripts/push-and-pr.sh"
    as  = "developer"
    env = {
      FEATURE_BASE_BRANCH = "{{feature_base_branch}}"
      WORKTREE_BRANCH     = "{{worktree_branch}}"
      TICKET_SOURCE_ID    = "{{ticket_source_id}}"
      PRIOR_CONTEXTS      = "{{prior_contexts}}"
    }
  }

  unless push-and-pr.no_changes {
    call workflow iterate-pr

    if auto_merge {
      gate pr_checks {
        timeout    = "2h"
        on_timeout = fail
      }

      gate pr_approval {
        as            = "reviewer"
        min_approvals = 1
        timeout       = "72h"
        on_timeout    = fail
      }

      call workflow rebase-worktree

      if rebase-worktree.has_conflicts {
        call workflow iterate-pr
      }

      gate pr_checks {
        timeout    = "2h"
        on_timeout = fail
      }

      script merge-and-close {
        run = ".conductor/scripts/merge-and-close.sh"
        as  = "merger"
        env = { TICKET_NUMBER = "{{ticket_source_id}}" }
      }
    }
  }
}
