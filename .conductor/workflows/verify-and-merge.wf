// Generated from template: verify-and-merge v1.4.0
workflow verify-and-merge {
  meta {
    description = "Check a reviewed PR is ready, verify it live against its issue's acceptance criteria, post the evidence, then squash-merge"
    trigger     = "manual"
    targets     = ["worktree"] // the agent builds and runs the branch; the ephemeral --pr clone can't (see merge-when-ready)
    group       = "Development"
  }

  inputs {
    confirm boolean
    // "false" restores the old stop after a base merge: merge, push, refuse (#3436).
    auto_rereview default = "true"
    // "false" restores the refusal when required checks are still running (#3480).
    wait_for_checks default = "true"
  }

  script check-pr-ready {
    run = ".conductor/scripts/check-pr-ready.sh"
    env = { CONFIRM = "{{confirm}}" DRY_RUN = "{{dry_run}}" TICKET_SOURCE_ID = "{{ticket_source_id}}" TRUSTED_REVIEW_BOTS = "conductor-ai-reviewer[bot]" AUTO_REREVIEW = "{{auto_rereview}}" WAIT_FOR_CHECKS = "{{wait_for_checks}}" }
  }

  // The base was merged in and pushed: the new head has no review and no CI yet (#3436).
  // The re-check runs with AUTO_REREVIEW off, so a base that moves again refuses rather
  // than starting a second round.
  if check-pr-ready.base_merged {
    call workflow iterate-pr

    script wait-for-pr-checks {
      run     = ".conductor/scripts/wait-for-pr-checks.sh"
      env     = { PR_NUMBER = "{{pr_number}}" REQUIRED_CHECKS = "{{required_checks}}" DRY_RUN = "{{dry_run}}" }
      timeout = 3000
    }

    script recheck-pr-ready {
      run = ".conductor/scripts/check-pr-ready.sh"
      env = { CONFIRM = "{{confirm}}" DRY_RUN = "{{dry_run}}" TICKET_SOURCE_ID = "{{ticket_source_id}}" TRUSTED_REVIEW_BOTS = "conductor-ai-reviewer[bot]" AUTO_REREVIEW = "false" WAIT_FOR_CHECKS = "false" }
    }
  }

  // Approved head, CI still running: wait for it, then check again (#3480). The recheck
  // runs with AUTO_REREVIEW and WAIT_FOR_CHECKS off, so anything that changed during the
  // wait refuses rather than starting a second round.
  if check-pr-ready.checks_pending {
    script wait-for-pending-checks {
      run     = ".conductor/scripts/wait-for-pr-checks.sh"
      env     = { PR_NUMBER = "{{pr_number}}" REQUIRED_CHECKS = "{{required_checks}}" DRY_RUN = "{{dry_run}}" }
      timeout = 3000
    }

    script recheck-after-checks {
      run = ".conductor/scripts/check-pr-ready.sh"
      env = { CONFIRM = "{{confirm}}" DRY_RUN = "{{dry_run}}" TICKET_SOURCE_ID = "{{ticket_source_id}}" TRUSTED_REVIEW_BOTS = "conductor-ai-reviewer[bot]" AUTO_REREVIEW = "false" WAIT_FOR_CHECKS = "false" }
    }
  }

  call verify-acceptance {
    output  = "verify-acceptance"
    as      = "developer"
    retries = 1
  }

  script post-verification {
    run = ".conductor/scripts/post-verification.sh"
    as  = "reviewer"
    env = { PRIOR_OUTPUT = "{{prior_output}}" PR_NUMBER = "{{pr_number}}" HEAD_SHA = "{{head_sha}}" DRY_RUN = "{{dry_run}}" TRUSTED_REVIEW_BOTS = "conductor-ai-reviewer[bot]" }
  }

  script check-summary {
    run = ".conductor/scripts/check-summary.sh"
    env = { PR_NUMBER = "{{pr_number}}" HEAD_SHA = "{{head_sha}}" BASE_BRANCH = "{{base_branch}}" DRY_RUN = "{{dry_run}}" }
  }

  // Review rounds and hand fixes can leave the PR's Summary describing code that is gone,
  // and the squash commit is built from it (#3471). Refresh it only when the head moved.
  if check-summary.summary_stale {
    call refresh-summary {
      output  = "refresh-summary"
      as      = "developer"
      retries = 1
    }

    script update-pr-summary {
      run = ".conductor/scripts/update-pr-summary.sh"
      as  = "developer"
      env = { PRIOR_OUTPUT = "{{prior_output}}" PR_NUMBER = "{{pr_number}}" HEAD_SHA = "{{head_sha}}" DRY_RUN = "{{dry_run}}" }
    }
  }

  if confirm {
    gate human_review {
      prompt     = "verify-and-merge posted its verification report on the PR (see the post-verification step). The Summary may have been refreshed from the final diff. Approve to squash-merge, or reject to leave the PR open."
      timeout    = "72h"
      on_timeout = fail
    }
  }

  script squash-merge {
    run = ".conductor/scripts/squash-merge.sh"
    as  = "merger"
    env = { PR_NUMBER = "{{pr_number}}" HEAD_SHA = "{{head_sha}}" BASE_BRANCH = "{{base_branch}}" LINKED_ISSUES = "{{linked_issues}}" DRY_RUN = "{{dry_run}}" }
  }
}
