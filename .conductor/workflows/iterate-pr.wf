workflow iterate-pr {
  meta {
    title       = "Iterate on PR Feedback"
    description = "Sync with main, resolve conflicts, lint, then iterate review until clean"
    trigger     = "manual"
    targets     = ["worktree"]
    group       = "Development"
  }

  inputs {
    // "true" re-reviews even when HEAD is the commit the last conductor review covered (#3307).
    force_review default = "false"
  }

  do {
    max_iterations = 10
    on_max_iter    = fail

    call workflow rebase-worktree

    if rebase-worktree.pulled_new_commits {
      call workflow lint-fix
    }

    // Review everything since the last conductor review, or the whole PR when
    // there is none (first cycle, rebase, force-push). #3074. When HEAD is
    // already the commit that review covered, it is reused, not repeated (#3307).
    script review-scope {
      run = ".conductor/scripts/review-scope.sh"
      env = {
        PR_NUMBER    = "{{pr_number}}"
        FORCE_REVIEW = "{{force_review}}"
      }
    }

    // HEAD is the commit the last conductor review covered: reuse that review's
    // verdict and findings instead of re-reviewing identical code (#3307).
    // The step is deliberately named review-aggregator, like the one inside review-pr:
    // the conditions below and triage-reviews read the latest review-aggregator by name,
    // whichever path (reuse or real review) produced it. Resume matches repeated names by
    // occurrence order, so it replays the same path as long as the PR's HEAD is unchanged.
    if review-scope.reuse_review {
      script review-aggregator {
        run = ".conductor/scripts/reuse-review.sh"
        env = {
          PR_NUMBER = "{{pr_number}}"
          REVIEW_ID = "{{reuse_review_id}}"
        }
      }
    }

    unless review-scope.reuse_review {
      call workflow review-pr {
        inputs {
          scope = "{{review_scope}}"
          since = "{{review_since}}"
        }
      }
    }

    if review-aggregator.has_blocking_findings {
      call triage-reviews {
        as = "developer"
        output = "triage-reviews"
      }

      if triage-reviews.has_to_address {
        call address-reviews {
          as = "developer"
        }

        script fmt-fix-pre-verify {
          run = ".conductor/scripts/fmt-fix.sh"
          env = {
            FMT_FIX_ALLOW_FAILURE = "1"
          }
        }

        script verify {
          run = ".conductor/scripts/verify.sh"
          env = { FEATURE_BASE_BRANCH = "{{feature_base_branch}}" }
        }

        if verify.has_failures {
          call address-reviews {
            retries = 1
            as      = "developer"
          }
          script fmt-fix-pre-reverify {
            run = ".conductor/scripts/fmt-fix.sh"
            env = {
              FMT_FIX_ALLOW_FAILURE = "1"
            }
          }
          script verify {
            run = ".conductor/scripts/verify.sh"
            env = { FEATURE_BASE_BRANCH = "{{feature_base_branch}}" }
          }
        }

        call workflow lint-fix
        script fmt-fix {
          run = ".conductor/scripts/fmt-fix.sh"
        }
      }

      // Pushback-only cycle (#3100): nothing is committed, so the loop below
      // exits and the PR would stay CHANGES_REQUESTED. Re-review once so the
      // aggregator sees the pushback replies. No commits are pushed here, so
      // the do-while still exits: one extra review per pushback round. Reuse
      // this cycle's scope (a reused review's own scope when one was reused).
      unless triage-reviews.has_to_address {
        if triage-reviews.has_pushback {
          call workflow review-pr {
            inputs {
              scope = "{{review_scope}}"
              since = "{{review_since}}"
            }
          }

          if review-aggregator.has_blocking_findings {
            script pushback-disputed {
              run = ".conductor/scripts/pushback-disputed.sh"
              env = {
                PR_NUMBER = "{{pr_number}}"
              }
            }

            gate human_review {
              prompt     = "The re-review after triage pushback still requests changes. Read the latest conductor review and the [Pushback on ...] comments on the PR, then dismiss the review or address the findings."
              timeout    = "72h"
              on_timeout = fail
            }
          }
        }
      }
    }

    script push {
      run = ".conductor/scripts/push.sh"
      as  = "developer"
    }
  } while push.pushed_new_commits
}
