workflow iterate-pr {
  meta {
    title       = "Iterate on PR Feedback"
    description = "Sync with main, resolve conflicts, lint, then iterate review until clean"
    trigger     = "manual"
    targets     = ["worktree"]
    group       = "Development"
  }

  do {
    max_iterations = 10
    on_max_iter    = fail

    call workflow rebase-worktree

    if rebase-worktree.pulled_new_commits {
      call workflow lint-fix
    }

    // Review everything since the last conductor review, or the whole PR when
    // there is none (first cycle, rebase, force-push). #3074. Also decides
    // whether off-diff findings are filed: only the PR's first conductor
    // review files them (#3090).
    script review-scope {
      run = ".conductor/scripts/review-scope.sh"
      env = {
        PR_NUMBER = "{{pr_number}}"
      }
    }

    call workflow review-pr {
      inputs {
        scope = "{{review_scope}}"
        since = "{{review_since}}"
        file_off_diff = "{{review_file_off_diff}}"
      }
    }

    if review-aggregator.has_blocking_findings {
      call triage-reviews {
        as = "developer"
      }

      if triage-reviews.has_to_address {
        call address-reviews {
          as = "developer"
        }

        script fmt-fix-pre-verify {
          run = ".conductor/scripts/fmt-fix.sh"
          env = {
            FMT_FIX_ALLOW_FAILURE = "1"
          }
        }

        call verify

        if verify.has_failures {
          call address-reviews {
            retries = 1
            as      = "developer"
          }
          script fmt-fix-pre-reverify {
            run = ".conductor/scripts/fmt-fix.sh"
            env = {
              FMT_FIX_ALLOW_FAILURE = "1"
            }
          }
          call verify
        }

        call workflow lint-fix
        script fmt-fix {
          run = ".conductor/scripts/fmt-fix.sh"
        }
      }
    }

    script push {
      run = ".conductor/scripts/push.sh"
      as  = "developer"
    }
  } while push.pushed_new_commits
}
