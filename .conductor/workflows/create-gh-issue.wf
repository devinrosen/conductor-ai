workflow create-gh-issue {
  meta {
    title       = "Create GitHub Issue"
    description = "Create a GitHub issue through an agentic conversation — gathers requirements, suggests labels/assignees, and creates a well-structured issue"
    trigger     = "manual"
    targets     = ["repo"]
    group       = "Release"
  }

  inputs {
    rough_idea required
  }

  call draft-gh-issue { output = "gh-issue-draft" }

  gate human_review {
    prompt     = "Review the drafted issue above. Approve to create it, or reject with feedback to revise."
    timeout    = "24h"
    on_timeout = fail
  }

  script create-gh-issue {
    run = ".conductor/scripts/create-gh-issue.sh"
    // prior_output is draft-gh-issue's structured output (the gate has none).
    // The script resolves owner/name itself; the repo variable is the
    // conductor slug, which gh --repo can't use (#3253).
    env = {
      PRIOR_OUTPUT = "{{prior_output}}"
      DRY_RUN      = "{{dry_run}}"
    }
  }
}
