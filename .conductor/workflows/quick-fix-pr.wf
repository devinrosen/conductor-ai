// Use quick-fix-pr for small, well-specified changes: a few files with clear
// acceptance criteria, prompt and workflow edits, small bugs. It skips the plan
// step and allows one review plus at most one re-review. ticket-to-pr stays the
// default for anything that needs a plan.
workflow quick-fix-pr {
  meta {
    title       = "Quick Fix to Pull Request"
    description = "Small, well-specified changes: implement from the ticket (no plan step), verify, lint, open a PR, and run one review with at most one re-review"
    trigger     = "manual"
    targets     = ["worktree"]
    group       = "Development"
  }

  inputs {
    ticket_id required
  }

  call implement-ticket {
    retries = 2
    as      = "developer"
  }

  script fmt-fix-pre-verify {
    run = ".conductor/scripts/fmt-fix.sh"
    env = {
      FMT_FIX_ALLOW_FAILURE = "1"
    }
  }

  call verify {
    output = "verify"
  }

  if verify.has_failures {
    call implement-ticket {
      retries = 1
      as      = "developer"
    }
    script fmt-fix-pre-reverify {
      run = ".conductor/scripts/fmt-fix.sh"
      env = {
        FMT_FIX_ALLOW_FAILURE = "1"
      }
    }
    call verify {
      output = "verify"
    }
  }

  call workflow lint-fix

  script fmt-fix {
    run = ".conductor/scripts/fmt-fix.sh"
  }

  script push-and-pr {
    run = ".conductor/scripts/push-and-pr.sh"
    as  = "developer"
    env = {
      FEATURE_BASE_BRANCH = "{{feature_base_branch}}"
      WORKTREE_BRANCH     = "{{worktree_branch}}"
      TICKET_SOURCE_ID    = "{{ticket_source_id}}"
    }
  }

  unless push-and-pr.no_changes {
    // The first review covers the whole PR (#3074).
    script review-scope {
      run = ".conductor/scripts/review-scope.sh"
      env = {
        PR_NUMBER = "{{pr_number}}"
      }
    }

    call workflow review-pr {
      inputs {
        scope = "{{review_scope}}"
        since = "{{review_since}}"
      }
    }

    if review-aggregator.has_blocking_findings {
      call triage-reviews {
        as     = "developer"
        output = "triage-reviews"
      }

      if triage-reviews.has_to_address {
        call address-reviews {
          as = "developer"
        }

        script fmt-fix-pre-verify-review {
          run = ".conductor/scripts/fmt-fix.sh"
          env = {
            FMT_FIX_ALLOW_FAILURE = "1"
          }
        }

        call verify {
          output = "verify"
        }

        if verify.has_failures {
          call address-reviews {
            retries = 1
            as      = "developer"
          }
          script fmt-fix-pre-reverify-review {
            run = ".conductor/scripts/fmt-fix.sh"
            env = {
              FMT_FIX_ALLOW_FAILURE = "1"
            }
          }
          call verify {
            output = "verify"
          }
        }

        call workflow lint-fix

        script fmt-fix-review {
          run = ".conductor/scripts/fmt-fix.sh"
        }

        script push {
          run = ".conductor/scripts/push.sh"
          as  = "developer"
        }

        // The one re-review. Fixes were pushed, so recompute the scope.
        script review-scope-rereview {
          run = ".conductor/scripts/review-scope.sh"
          env = {
            PR_NUMBER = "{{pr_number}}"
          }
        }

        call workflow review-pr {
          inputs {
            scope = "{{review_scope}}"
            since = "{{review_since}}"
          }
        }

        if review-aggregator.has_blocking_findings {
          gate human_review {
            prompt     = "quick-fix-pr allows one re-review, and it still requests changes. Address the findings by hand, or rerun as ticket-to-pr or iterate-pr."
            timeout    = "72h"
            on_timeout = fail
          }
        }
      }

      // Pushback-only cycle (#3100): nothing was committed, so re-review once
      // with this cycle's scope so the aggregator sees the pushback replies.
      unless triage-reviews.has_to_address {
        if triage-reviews.has_pushback {
          call workflow review-pr {
            inputs {
              scope = "{{review_scope}}"
              since = "{{review_since}}"
            }
          }

          if review-aggregator.has_blocking_findings {
            script pushback-disputed {
              run = ".conductor/scripts/pushback-disputed.sh"
              env = {
                PR_NUMBER = "{{pr_number}}"
              }
            }

            gate human_review {
              prompt     = "quick-fix-pr allows one re-review, and it still requests changes after triage pushback. Read the latest conductor review and the [Pushback on ...] comments on the PR, then dismiss the review or address the findings."
              timeout    = "72h"
              on_timeout = fail
            }
          }
        }
      }
    }
  }
}
