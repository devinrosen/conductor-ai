---
name: ticket-to-pr
description: Full development cycle — plan from ticket, implement, push PR, run review swarm, iterate until clean
version: "1.0.0"
target_types:
  - worktree
hints:
  - Check the repo's CI config (.github/workflows/ or similar) to understand what lint/fmt commands are used and customize the lint-fix script accordingly
  - Look at existing PRs to understand the team's PR title and description conventions
  - Check if the repo uses a monorepo structure — if so, the fmt-fix and push-and-pr scripts may need workspace-aware commands
  - Inspect CODEOWNERS or team structure to set appropriate reviewer roles
  - Check if the repo has a CONTRIBUTING.md or PR template in .github/PULL_REQUEST_TEMPLATE.md
  - If the repo uses Jira or another issue tracker instead of GitHub issues, the merge-and-close script's ticket close logic will need adjustment
  - "Give the plan's schema an optional `decisions` list (question + default) with a `needs_decision: \"decisions.length > 0\"` marker, and stop at a human gate after plan when it is set. Only questions the user must answer (scope, breaking API, data, user-visible behaviour) belong there. A gate prompt is fixed text, so print the questions in a script step just before it; the gate's feedback reaches implement as gate_feedback"
  - After implement, have a check-plan agent compare the plan's tasks and listed tests with the diff and emit `plan_incomplete`; send missing items to a dedicated complete-plan agent (not a third implement call) before verify, so that work is verified too
  - Have the plan agent write PLAN.md to "$(git rev-parse --git-dir)/PLAN.md", not the worktree root, and point the implement and triage-reviews agents there. Git never tracks that directory, so the plan stays available through the review loop without a .gitignore entry or a cleanup step
---
workflow ticket-to-pr {
  meta {
    description = "Full development cycle — plan from ticket, implement, push PR, run review swarm, iterate until clean"
    trigger     = "manual"
    targets     = ["worktree"]
    group       = "Development"
  }

  inputs {
    ticket_id  required
    qualify    boolean
    auto_merge boolean
  }

  if qualify {
    call workflow qualify-ticket {
      inputs {
        ticket_id = "{{ticket_id}}"
      }
    }
  }

  call plan { output = "task-plan" }

  if plan.needs_decision {
    script show-plan-decisions {
      run = ".conductor/scripts/show-plan-decisions.sh"
      env = { PRIOR_OUTPUT = "{{prior_output}}" }
    }
    gate human_review {
      prompt     = "The plan has decisions for you; the questions and the plan's defaults are in the show-plan-decisions step. Approve with your answers as feedback (approving without feedback keeps the defaults), or reject to stop the run."
      timeout    = "72h"
      on_timeout = fail
    }
  }

  call implement {
    retries = 2
    as      = "developer"
  }

  call check-plan { output = "plan-check" }
  if check-plan.plan_incomplete {
    call complete-plan {
      retries = 1
      as      = "developer"
    }
  }

  call workflow lint-fix

  script fmt-fix {
    run = ".conductor/scripts/fmt-fix.sh"
  }

  script push-and-pr {
    run = ".conductor/scripts/push-and-pr.sh"
    as  = "developer"
    env = { FEATURE_BASE_BRANCH = "{{feature_base_branch}}" }
  }

  unless push-and-pr.no_changes {
    call workflow iterate-pr

    if auto_merge {
      gate pr_checks {
        timeout    = "2h"
        on_timeout = fail
      }

      gate pr_approval {
        as            = "reviewer"
        min_approvals = 1
        timeout       = "72h"
        on_timeout    = fail
      }

      call workflow rebase-worktree

      if rebase-worktree.has_conflicts {
        call workflow iterate-pr
      }

      gate pr_checks {
        timeout    = "2h"
        on_timeout = fail
      }

      script merge-and-close {
        run = ".conductor/scripts/merge-and-close.sh"
        as  = "merger"
        env = { TICKET_NUMBER = "{{ticket_source_id}}" }
      }
    }
  }
}
